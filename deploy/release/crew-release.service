[Unit]
Description=CREW reusable verified production release agent
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/usr/local/lib/crew-release/release_agent.py

[Service]
Type=simple
User=root
Group=986
WorkingDirectory=/var/lib/crew-release
ExecStart=/usr/bin/python3 /usr/local/lib/crew-release/release_agent.py
Environment=CREW_RELEASE_BRIDGE_UID=10001
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=crew-release
RuntimeDirectoryMode=0770
StateDirectory=crew-release
StateDirectoryMode=0755
UMask=0007
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_CHOWN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_FOWNER
# Retain only the already bounded credential-drop capabilities across exec.
AmbientCapabilities=CAP_SETUID CAP_SETGID
ReadWritePaths=/opt/crew /var/lib/crew-release /var/backups/crew /run/crew-release
MemoryMax=350M
TasksMax=80
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
