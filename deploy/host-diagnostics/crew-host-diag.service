[Unit]
Description=CREW restricted host diagnostics (read-only)
Documentation=file:/opt/crew-dev-bridge/deploy/host-diagnostics/README.md
After=network.target
ConditionPathExists=/opt/crew-dev-bridge/host/agent.py

[Service]
Type=simple
User=crew
Group=986
WorkingDirectory=/opt/crew-dev-bridge
ExecStart=/opt/crew-dev-bridge/.host-agent-venv/bin/python -m host.agent
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CREW_HOST_DIAG_SOCKET=/run/crew-host-diag/host.sock
Environment=CREW_HOST_DIAG_BRIDGE_UID=10001
LoadCredential=db_dsn:/etc/crew-host-diag/db_dsn
RuntimeDirectory=crew-host-diag
RuntimeDirectoryMode=0770
UMask=0007
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/crew-host-diag
LimitNOFILE=256
TasksMax=32
MemoryMax=160M

[Install]
WantedBy=multi-user.target
