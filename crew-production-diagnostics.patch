@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Fixed, read-only production checks run locally by a restricted timer.
+
+Produces only status codes and counts, never stdout/stderr from Git, service
+logs, environment variables, DB credentials, tracked filenames or game data.
+Requires NO GitHub token, database login, network, or elevated privileges.
+"""
+from __future__ import annotations
+
+import http.client
+import json
+import os
+import socket
+import subprocess
+import tempfile
+from datetime import datetime, timezone
+from pathlib import Path
+
+PRODUCTION = Path('/opt/crew')
+OUTPUT_DIR = Path('/var/lib/crew-dev-bridge/diagnostics')
+HEALTH_SOCKET = '/run/crew/crew.sock'
+SERVICE_NAMES = ('crew', 'nginx', 'docker', 'crew-tunnel')
+RUN_ENV = {
+    'PATH': '/usr/bin:/bin', 'HOME': '/nonexistent', 'LC_ALL': 'C',
+    'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': '/dev/null',
+    'GIT_OPTIONAL_LOCKS': '0', 'GIT_TERMINAL_PROMPT': '0',
+}
+
+
+def _run(command: list[str], timeout: float = 5.0):
+    try:
+        return subprocess.run(command, capture_output=True, text=True,
+                              timeout=timeout, env=RUN_ENV, check=False)
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+
+
+def _service_states() -> dict:
+    allowed = {'active', 'inactive', 'failed', 'activating', 'deactivating'}
+    result = {}
+    for name in SERVICE_NAMES:
+        cmd = _run(['/usr/bin/systemctl', 'is-active', name])
+        state = cmd.stdout.strip() if cmd is not None else ''
+        result[name] = state if state in allowed else 'unknown'
+    return result
+
+
+def _git_status() -> dict:
+    prefix = ['/usr/bin/git', '-C', str(PRODUCTION),
+              '-c', 'core.hooksPath=/dev/null', '-c', 'core.pager=cat']
+    commit = _run(prefix + ['rev-parse', 'HEAD'])
+    branch = _run(prefix + ['symbolic-ref', '--quiet', '--short', 'HEAD'])
+    changed = _run(prefix + ['status', '--porcelain=v1', '--untracked-files=normal'], timeout=8)
+    sha = commit.stdout.strip() if commit and commit.returncode == 0 else None
+    if not (isinstance(sha, str) and len(sha) == 40 and all(c in '0123456789abcdef' for c in sha)):
+        sha = None
+    ref = branch.stdout.strip() if branch and branch.returncode == 0 else None
+    if ref and (len(ref) > 80 or not all(c.isascii() and (c.isalnum() or c in '_./-') for c in ref)):
+        ref = None
+    dirty = bool(changed.stdout) if changed and changed.returncode == 0 else None
+    return {'git_commit': sha, 'git_branch': ref, 'tracked_or_untracked_changes': dirty}
+
+
+class _UnixHTTPConnection(http.client.HTTPConnection):
+    def __init__(self):
+        super().__init__('localhost', timeout=3)
+
+    def connect(self):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.settimeout(3)
+        self.sock.connect(HEALTH_SOCKET)
+
+
+def _health_status() -> int | None:
+    connection = _UnixHTTPConnection()
+    try:
+        connection.request('GET', '/health', headers={'Host': 'cadacrew.fun'})
+        response = connection.getresponse()
+        response.read(512)
+        return int(response.status)
+    except (OSError, http.client.HTTPException, ValueError):
+        return None
+    finally:
+        connection.close()
+
+
+def _host_resources() -> dict:
+    try:
+        info = os.statvfs(PRODUCTION)
+        disk = round(info.f_bavail * info.f_frsize / (1024 ** 3), 2)
+    except OSError:
+        disk = None
+    memory = None
+    try:
+        with open('/proc/meminfo', encoding='ascii') as handle:
+            for line in handle:
+                if line.startswith('MemAvailable:'):
+                    memory = int(line.split()[1]) // 1024
+                    break
+    except (OSError, ValueError, IndexError):
+        pass
+    return {'disk_available_gib': disk, 'memory_available_mib': memory}
+
+
+def collect_snapshot() -> dict:
+    production = _git_status()
+    production['health_http_status'] = _health_status()
+    return {
+        'schema': 1,
+        'checked_at': datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00', 'Z'),
+        'services': _service_states(),
+        'production': production,
+        'host': _host_resources(),
+    }
+
+
+def write_snapshot(snapshot: dict, directory: Path = OUTPUT_DIR) -> None:
+    """Replace within a directory bind mount (NOT a mounted individual file)."""
+    # This directory must exist and be owned by the 'crew' system account,
+    # with group read/traverse for the bridge's numeric GID 10001, no group write.
+    if not directory.is_dir() or directory.is_symlink():
+        raise RuntimeError('Diagnostics output directory is not provisioned')
+    fd, name = tempfile.mkstemp(prefix='.status-', dir=directory)
+    try:
+        os.fchmod(fd, 0o640)
+        with os.fdopen(fd, 'w', encoding='utf-8') as output:
+            json.dump(snapshot, output, sort_keys=True, separators=(',', ':'))
+            output.write('\n')
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(name, directory / 'status.json')
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+if __name__ == '__main__':
+    write_snapshot(collect_snapshot())
diff --git a/tests/test_production_diagnostics.py b/tests/test_production_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/tests/test_production_diagnostics.py
@@ -0,0 +1,97 @@
+"""Read-only snapshot contract; no subprocess is started by the MCP reader."""
+import json
+import os
+import stat
+import tempfile
+import unittest
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+
+from bridge.production_status import read_snapshot
+from scripts.production_snapshot import write_snapshot
+
+
+def good_snapshot(now):
+    return {
+        'schema': 1,
+        'checked_at': now.isoformat().replace('+00:00', 'Z'),
+        'services': {name: 'active' for name in ('crew', 'nginx', 'docker', 'crew-tunnel')},
+        'production': {
+            'git_commit': 'a' * 40, 'git_branch': 'main',
+            'tracked_or_untracked_changes': False, 'health_http_status': 200,
+        },
+        'host': {'disk_available_gib': 42.5, 'memory_available_mib': 8192},
+    }
+
+
+class TestProductionSnapshot(unittest.TestCase):
+    def setUp(self):
+        self.folder = tempfile.TemporaryDirectory()
+        self.addCleanup(self.folder.cleanup)
+        self.root = Path(self.folder.name)
+        self.path = self.root / 'status.json'
+        self.now = datetime.now(timezone.utc)
+
+    def save(self, status):
+        self.path.write_text(json.dumps(status), encoding='utf-8')
+
+    def test_missing_does_not_crash_or_expose_paths(self):
+        response = read_snapshot(self.path, now=self.now)
+        self.assertFalse(response['available'])
+        self.assertNotIn(str(self.path), str(response))
+
+    def test_read_only_fresh_snapshot(self):
+        self.save(good_snapshot(self.now))
+        before = self.path.stat().st_mtime_ns
+        out = read_snapshot(self.path, now=self.now)
+        self.assertTrue(out['available'])
+        self.assertEqual(out['production']['git_commit'], 'a' * 40)
+        self.assertEqual(out['services']['crew'], 'active')
+        self.assertEqual(out['production']['database_revision'], 'not_checked')
+        self.assertEqual(before, self.path.stat().st_mtime_ns)
+        self.assertEqual(out['production_access'], 'snapshot_only')
+
+    def test_stale_snapshot_not_reported_as_current(self):
+        old = self.now - timedelta(hours=1)
+        self.save(good_snapshot(old))
+        response = read_snapshot(self.path, now=self.now)
+        self.assertFalse(response['available'])
+        self.assertEqual(response['reason'], 'stale_snapshot')
+        self.assertNotIn('services', response)
+
+    def test_unexpected_fields_cannot_leak(self):
+        data = good_snapshot(self.now)
+        data['prod_secret'] = 'SECRET_DO_NOT_LEAK'
+        data['production']['db_password'] = 'SECRET_DO_NOT_LEAK'
+        data['host']['private_ip'] = 'SECRET_DO_NOT_LEAK'
+        self.save(data)
+        output = read_snapshot(self.path, now=self.now)
+        self.assertTrue(output['available'])
+        self.assertNotIn('SECRET_DO_NOT_LEAK', json.dumps(output))
+
+    def test_invalid_fields_and_oversize_rejected(self):
+        bad = good_snapshot(self.now)
+        bad['services']['crew'] = ['active']
+        self.save(bad)
+        self.assertFalse(read_snapshot(self.path, now=self.now)['available'])
+        self.path.write_text('X' * 5000, encoding='ascii')
+        self.assertFalse(read_snapshot(self.path, now=self.now)['available'])
+
+    def test_symlink_rejected(self):
+        other = self.root / 'target'
+        other.write_text(json.dumps(good_snapshot(self.now)))
+        self.path.symlink_to(other)
+        self.assertEqual(read_snapshot(self.path, now=self.now)['reason'], 'invalid_snapshot')
+
+    def test_atomic_writer_for_directory_bind_mount(self):
+        self.save({'old': True})
+        old_inode = self.path.stat().st_ino
+        write_snapshot(good_snapshot(self.now), self.root)
+        self.assertNotEqual(old_inode, self.path.stat().st_ino)
+        self.assertEqual(stat.S_IMODE(self.path.stat().st_mode), 0o640)
+        self.assertTrue(read_snapshot(self.path, now=self.now)['available'])
+        self.assertFalse(any(x.name.startswith('.status-') for x in self.root.iterdir()))
+
+
+if __name__ == '__main__':
+    unittest.main()
